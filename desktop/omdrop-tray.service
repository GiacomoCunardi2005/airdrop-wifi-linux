[Unit]
Description=AirDrop GNOME indicator (Owly / Omdrop)
PartOf=graphical-session.target
After=graphical-session-pre.target

[Service]
ExecStart=/usr/bin/python3 %h/.local/share/omdrop-tray/tray.py
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
Restart=on-failure
RestartSec=5

[Install]
WantedBy=graphical-session.target
