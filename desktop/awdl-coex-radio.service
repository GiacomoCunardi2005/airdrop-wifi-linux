[Unit]
Description=AirDrop radio next to the connected Wi-Fi (Owly AWDL engine on awdlmon)
# Needs a coexistence driver (docs/PORTING.md); with a stock driver this unit stays inactive.
ConditionPathExistsGlob=/sys/module/*/parameters/awdl_coex
# awdlmon is prepared before NetworkManager; the engine starts once the Wi-Fi is up.
After=awdl-coex-boot.service network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
ExecStartPre=/usr/lib/awdl-coex/coex-session setup
ExecStart=/usr/lib/awdl-coex/coex-radio
ExecStopPost=/usr/lib/awdl-coex/coex-session teardown
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
