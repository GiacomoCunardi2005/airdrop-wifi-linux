#!/bin/bash
# Installs "Wi-Fi + AirDrop insieme" through the pacman package (packaging/arch), plus the GNOME tray
# when this user has the Omdrop panel. Run as the desktop user from a clone; asks for sudo.
# Same as `cd packaging/arch && makepkg -si`, then starting it now instead of after a reboot.
# --remove uninstalls the package and puts the stock driver back.
set -euo pipefail
REPO=$(cd "$(dirname -- "$0")/.." && pwd)
PKG=airdrop-wifi-coex
TRAY=~/.local/share/omdrop-tray

coex() { grep -qx Y /sys/module/*/parameters/awdl_coex 2>/dev/null; }
reload() {
    sudo modprobe -r iwlmvm iwlwifi
    sudo modprobe iwlmvm
    for _ in {1..60}; do nmcli -t -f DEVICE,STATE device | grep -q '^wlan0:connected' && return 0; sleep 1; done
    echo "Wi-Fi non ancora riconnesso: controlla NetworkManager." >&2
}

# Earlier versions of this script installed by hand; pacman refuses files it doesn't own.
remove_manual() {
    systemctl --user disable --now omdrop-coex-receive.service 2>/dev/null || true
    rm -f ~/.config/systemd/user/omdrop-coex-receive.service ~/.config/systemd/user/default.target.wants/omdrop-coex-receive.service
    sudo systemctl disable --now awdl-coex-radio.service awdl-coex-boot.service 2>/dev/null || true
    sudo rm -f /etc/systemd/system/awdl-coex-radio.service /etc/systemd/system/awdl-coex-boot.service \
        /etc/modprobe.d/awdl-coex.conf
    sudo rm -rf /usr/local/lib/awdl-coex /lib/modules/*/updates/awdl-coex
    if ! pacman -Qq "$PKG" &>/dev/null; then
        sudo dkms remove iwlwifi-awdl-coex/7.3 --all 2>/dev/null || true
        sudo rm -rf /usr/src/iwlwifi-awdl-coex-7.3 /usr/lib/systemd/system-sleep/awdl-coex
    fi
}

if [[ ${1:-} == --remove ]]; then
    remove_manual
    pacman -Qq "$PKG" &>/dev/null && sudo pacman -R --noconfirm "$PKG"
    sudo depmod -a
    reload
    echo "Driver originale ripristinato."
    exit 0
fi

remove_manual
(cd "$REPO/packaging/arch" && makepkg -sif --noconfirm)

# The tray is per user (Omdrop + Quickshell live in the home directory).
if [[ -d $TRAY ]]; then
    install -m755 "$REPO/desktop/omdrop.py" "$REPO/desktop/tray.py" "$TRAY/"
    cp -a "$REPO/desktop/qml" "$TRAY/"
    systemctl --user restart omdrop-tray.service 2>/dev/null || true
fi

# Now rather than at the next boot. The first load of the patched driver drops Wi-Fi for a few seconds.
coex || reload
coex || { echo "Driver coex non attivo: vedi dmesg | grep awdl_coex (riavvia se il driver era in uso)." >&2; exit 1; }
systemctl --user daemon-reload
systemctl --user enable omdrop-coex-receive.service
sudo systemctl start awdl-coex-boot.service awdl-coex-radio.service
systemctl --user start omdrop-coex-receive.service
echo "Installato: AirDrop acceso con il Wi-Fi connesso, anche a ogni avvio, finché non lo spegni."
