[Unit]
Description=Owly mDNS replies for Omdrop on awdl0
BindsTo=airdrop-receiver.service
After=airdrop-receiver.service

[Service]
ExecStart=/usr/bin/python3 %h/.local/share/omdrop-tray/mdns
Restart=on-failure
RestartSec=3
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
RestrictAddressFamilies=AF_INET6 AF_UNIX AF_NETLINK

[Install]
WantedBy=airdrop-receiver.service
