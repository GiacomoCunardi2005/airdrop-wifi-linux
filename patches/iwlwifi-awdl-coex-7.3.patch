@@ -14,6 +14,19 @@ static int iwl_mvm_mld_mac_add_interface(struct ieee80211_hw *hw,
 
 	guard(mvm)(mvm);
 
+	/* awdl_coex: the firmware ACKs only frames sent to a MAC context's own
+	 * address. A listener on the station's address gets no ACKs of its own,
+	 * so the iPhone never lists us. Require a separate AWDL address.
+	 */
+	if (iwlwifi_mod_params.awdl_coex && vif->type == NL80211_IFTYPE_MONITOR) {
+		if (ether_addr_equal(vif->addr, mvm->nvm_data->hw_addr)) {
+			IWL_ERR(mvm, "awdl_coex: monitor %pM shares the station address, set its own MAC first\n",
+				vif->addr);
+			return -EADDRINUSE;
+		}
+		IWL_ERR(mvm, "awdl_coex: listener address %pM\n", vif->addr);
+	}
+
 	iwl_mvm_mac_init_mvmvif(mvm, mvmvif);
 
