+	if (iwlwifi_mod_params.awdl_coex &&
+	    vif->type == NL80211_IFTYPE_MONITOR) {
+		struct ieee80211_vif *sta = iwl_mvm_get_bss_vif(mvm);
+
+		/* Promiscuous listening on the station's channel steals its traffic. */
+		/* Station down/unassociated is allowed: cfg80211 only lets us set the
+		 * monitor channel while no other interface runs; the station joins after. */
+		if (!IS_ERR_OR_NULL(sta) && sta->cfg.assoc &&
+		    sta->bss_conf.chanreq.oper.chan == ctx->def.chan) {
+			IWL_ERR(mvm, "awdl_coex: monitor chanctx refused\n");
+			return -EBUSY;
+		}
+		IWL_ERR(mvm, "awdl_coex: monitor chanctx accepted on %d MHz\n",
+			ctx->def.chan->center_freq);
