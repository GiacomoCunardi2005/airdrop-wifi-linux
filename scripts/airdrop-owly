#!/bin/bash
set -euo pipefail
DEST="$(xdg-user-dir DOWNLOAD)/AirDrop"
LOGDIR="$HOME/awdl-diag"
mkdir -p "$DEST" "$LOGDIR"
exec 9>"$XDG_RUNTIME_DIR/airdrop-owly.lock"
flock -n 9 || { echo 'AirDrop è già aperto.'; exit 1; }
STAMP=$(date +%Y%m%d-%H%M%S)
RADIO_LOG="$LOGDIR/owly-radio-$STAMP.log"
RECEIVE_LOG="$LOGDIR/owly-receive-$STAMP.log"
cleanup() {
    trap - EXIT
    kill -TERM "$RADIO_PID" 2>/dev/null || true
    wait "$RADIO_PID" 2>/dev/null || true
    echo "Prova terminata. Ripristino Wi-Fi richiesto. Log: $RECEIVE_LOG"
}
echo 'AirDrop per 5 minuti. Il Wi-Fi Internet viene temporaneamente scollegato.'
owly radio up --for 330 >"$RADIO_LOG" 2>&1 &
RADIO_PID=$!
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM HUP
READY=0
for ((i=0; i<30; i++)); do
    kill -0 "$RADIO_PID" 2>/dev/null || { cat "$RADIO_LOG"; exit 1; }
    if ip -6 addr show dev awdl0 scope link 2>/dev/null | grep -q 'inet6'; then
        READY=1
        break
    fi
    sleep 1
done
[[ $READY == 1 ]] || { cat "$RADIO_LOG"; exit 1; }
echo "iPhone: Condividi → AirDrop → $(hostname). File in: $DEST"
echo 'Quando compare accept? scrivi y e premi Invio entro 15 secondi. Ctrl+C termina.'
timeout --foreground --signal=INT 300 owly receive --name "$(hostname)" --dir "$DEST" 2>&1 | tee "$RECEIVE_LOG"
